{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://smartdoc.agent/schema/ir/0.1",
  "title": "SmartDoc-Agent 统一 IR v0.1",
  "description": "解析器输出、LLM 输入的确定性代码元数据中间表示（L2）",
  "type": "object",
  "required": ["irVersion", "projectName", "sourceChannels", "packages", "classes"],
  "properties": {
    "irVersion": { "type": "string", "const": "0.1" },
    "projectName": { "type": "string" },
    "sourceChannels": {
      "type": "array",
      "items": { "type": "string", "enum": ["bytecode", "source"] }
    },
    "packages": { "type": "array", "items": { "$ref": "#/definitions/PackageIR" } },
    "classes": { "type": "array", "items": { "$ref": "#/definitions/ClassIR" } }
  },
  "definitions": {
    "PackageIR": {
      "type": "object",
      "required": ["name", "classFqns", "classSummary"],
      "properties": {
        "name": { "type": "string" },
        "classFqns": { "type": "array", "items": { "type": "string" } },
        "classSummary": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ClassIR": {
      "type": "object",
      "required": ["fqn", "name", "packageName", "kind", "modifiers", "superClass", "interfaces", "typeParameters", "annotations", "javadoc", "fields", "methods", "dependencies"],
      "properties": {
        "fqn": { "type": "string" },
        "name": { "type": "string" },
        "packageName": { "type": "string" },
        "kind": { "type": "string", "enum": ["class", "interface", "enum", "annotation", "record"] },
        "modifiers": { "type": "array", "items": { "type": "string" } },
        "superClass": { "type": ["string", "null"] },
        "interfaces": { "type": "array", "items": { "type": "string" } },
        "typeParameters": { "type": "array", "items": { "type": "string" } },
        "annotations": { "type": "array", "items": { "type": "string" } },
        "javadoc": { "type": ["string", "null"] },
        "fields": { "type": "array", "items": { "$ref": "#/definitions/FieldIR" } },
        "methods": { "type": "array", "items": { "$ref": "#/definitions/MethodIR" } },
        "dependencies": { "type": "array", "items": { "type": "string" } }
      }
    },
    "FieldIR": {
      "type": "object",
      "required": ["name", "type", "modifiers", "annotations", "javadoc"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "modifiers": { "type": "array", "items": { "type": "string" } },
        "annotations": { "type": "array", "items": { "type": "string" } },
        "javadoc": { "type": ["string", "null"] }
      }
    },
    "MethodIR": {
      "type": "object",
      "required": ["fqn", "name", "declaringClassFqn", "modifiers", "returnType", "typeParameters", "parameters", "throwsTypes", "annotations", "javadoc", "invokedMethods", "bytecodeSize"],
      "properties": {
        "fqn": { "type": "string" },
        "name": { "type": "string" },
        "declaringClassFqn": { "type": "string" },
        "modifiers": { "type": "array", "items": { "type": "string" } },
        "returnType": { "type": ["string", "null"] },
        "typeParameters": { "type": "array", "items": { "type": "string" } },
        "parameters": { "type": "array", "items": { "$ref": "#/definitions/ParameterIR" } },
        "throwsTypes": { "type": "array", "items": { "type": "string" } },
        "annotations": { "type": "array", "items": { "type": "string" } },
        "javadoc": { "type": ["string", "null"] },
        "invokedMethods": { "type": "array", "items": { "type": "string" } },
        "bytecodeSize": { "type": ["integer", "null"] }
      }
    },
    "ParameterIR": {
      "type": "object",
      "required": ["name", "type", "annotations", "javadoc"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "type": { "type": "string" },
        "annotations": { "type": "array", "items": { "type": "string" } },
        "javadoc": { "type": ["string", "null"] }
      }
    }
  }
}